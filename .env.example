# Optional. Copy to .env.local (gitignored). Only needed if you want the tutor without using the in-app
# Settings panel. A key saved in the browser (Settings) takes precedence over these.
# Provider: anthropic | openai | google | openrouter | custom
LLM_PROVIDER=
LLM_API_KEY=
# Blank uses the provider default
LLM_MODEL=
# Only for LLM_PROVIDER=custom (any OpenAI-compatible server), e.g. http://localhost:11434/v1
LLM_BASE_URL=

# Legacy, still honoured when LLM_PROVIDER is unset (implies anthropic):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
