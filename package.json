{
  "name": "cloud-dojo",
  "private": true,
  "version": "0.0.0",
  "description": "Learn AWS services hands-on against the local AWS Emulator. Not affiliated with AWS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannyavrs/cloud-dojo.git"
  },
  "homepage": "https://github.com/dannyavrs/cloud-dojo#readme",
  "bugs": {
    "url": "https://github.com/dannyavrs/cloud-dojo/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:test": "bun scripts/with-temp-data.ts bun scripts/dev.ts",
    "dev:web": "vite",
    "server": "bun server/index.ts",
    "start": "bun run build && bun server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "bun test",
    "test:e2e": "bun scripts/with-temp-data.ts bun scripts/e2e.ts",
    "emulator:build": "docker build --platform linux/arm64 -t cloud-dojo-emulator:1.0.341 emulator",
    "emulator:stop": "docker rm -f cloud-dojo-emulator",
    "capture": "bun scripts/with-temp-data.ts bun scripts/capture-run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/google": "^4.0.118",
    "@ai-sdk/openai": "^4.0.115",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@aws-sdk/client-api-gateway": "^3.1164.0",
    "@aws-sdk/client-apigatewayv2": "^3.1164.0",
    "@aws-sdk/client-cloudwatch": "^3.1164.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1164.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1164.0",
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-eventbridge": "^3.1164.0",
    "@aws-sdk/client-iam": "^3.1165.0",
    "@aws-sdk/client-kms": "^3.1164.0",
    "@aws-sdk/client-lambda": "^3.1165.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-scheduler": "^3.1167.0",
    "@aws-sdk/client-secrets-manager": "^3.1167.0",
    "@aws-sdk/client-sfn": "^3.1164.0",
    "@aws-sdk/client-sns": "^3.1164.0",
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/client-sts": "^3.1164.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@smithy/node-http-handler": "^4.14.2",
    "ai": "^7.0.170",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
